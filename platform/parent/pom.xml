<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Internal parent for the platform's own modules (foundation, bricks, apps, platform/rules). It reuses
    amef-build-parent so the platform builds with the same plugins and gates as consumer services, with one
    difference: the banned-dependencies rule is off, because bricks are the owners of those libraries.
    Not published for consumers; services use amef-build-parent.
  -->
  <parent>
    <groupId>io.github.williamthomas1997</groupId>
    <artifactId>amef-build-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../build-parent/pom.xml</relativePath>
  </parent>

  <artifactId>amef-platform-parent</artifactId>
  <packaging>pom</packaging>

  <name>AMEF :: platform-parent</name>
  <description>Internal parent for AMEF platform modules.</description>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <!-- Bricks own the infrastructure libraries that services are banned from using directly. -->
            <id>amef-banned-dependencies</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
