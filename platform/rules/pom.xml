<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Platform self-checks. Test-only module that puts every platform module on the test classpath and verifies:
    - the layer rule (spec 2.3): a module of layer N never depends on a module of layer > N. Layers and packages
      are read from bricks/*/brick.yaml, foundation/*/module.yaml and apps/*/module.yaml;
    - the toolchain smoke test (*IT): Testcontainers can start a container on this machine / CI runner.
    Never published.
  -->
  <parent>
    <groupId>io.github.williamthomas1997</groupId>
    <artifactId>amef-platform-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../parent/pom.xml</relativePath>
  </parent>

  <artifactId>amef-platform-rules</artifactId>
  <packaging>jar</packaging>

  <name>AMEF :: platform-rules</name>
  <description>Platform self-checks: layer rule over all modules, toolchain smoke test.</description>

  <properties>
    <maven.install.skip>true</maven.install.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
    <amef.repo.root>${project.basedir}/../..</amef.repo.root>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.williamthomas1997</groupId>
      <artifactId>amef-contracts</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.williamthomas1997</groupId>
      <artifactId>amef-architecture-guard</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.williamthomas1997</groupId>
      <artifactId>amef-test-support</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.williamthomas1997</groupId>
      <artifactId>amef-observability-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.williamthomas1997</groupId>
      <artifactId>amef-observability-reactive</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.williamthomas1997</groupId>
      <artifactId>amef-observability-servlet</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.williamthomas1997</groupId>
      <artifactId>amef-redis-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.williamthomas1997</groupId>
      <artifactId>amef-redis-reactive</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.williamthomas1997</groupId>
      <artifactId>amef-redis-servlet</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.williamthomas1997</groupId>
      <artifactId>amef-messaging-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.williamthomas1997</groupId>
      <artifactId>amef-messaging-reactive</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.williamthomas1997</groupId>
      <artifactId>amef-messaging-servlet</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.williamthomas1997</groupId>
      <artifactId>amef-resilience-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.williamthomas1997</groupId>
      <artifactId>amef-resilience-reactive</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.williamthomas1997</groupId>
      <artifactId>amef-resilience-servlet</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.williamthomas1997</groupId>
      <artifactId>amef-external-call-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.williamthomas1997</groupId>
      <artifactId>amef-external-call-reactive</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.williamthomas1997</groupId>
      <artifactId>amef-external-call-servlet</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.williamthomas1997</groupId>
      <artifactId>amef-cache-sync-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.williamthomas1997</groupId>
      <artifactId>amef-cache-sync-reactive</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.williamthomas1997</groupId>
      <artifactId>amef-cache-sync-servlet</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.williamthomas1997</groupId>
      <artifactId>amef-gateway</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.williamthomas1997</groupId>
      <artifactId>amef-audit-service</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.williamthomas1997</groupId>
      <artifactId>amef-sample-service-reactive</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.williamthomas1997</groupId>
      <artifactId>amef-sample-service-servlet</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <amef.repo.root>${amef.repo.root}</amef.repo.root>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
