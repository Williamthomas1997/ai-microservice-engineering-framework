    "deny": [
      "Bash(git checkout:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git filter-repo:*)",
      "Bash(git filter-branch:*)",
      "Bash(rm -rf /:*)",
      "Edit(internal/**)",
      "Edit(/internal/**)",
      "Write(internal/**)",
      "Write(/internal/**)",
      "Edit(.claude/settings.json)",
      "Edit(/.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Write(/.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Edit(/.claude/settings.local.json)",
      "Write(.claude/settings.local.json)",
      "Write(/.claude/settings.local.json)",
      "Edit(tools/guard/**)",
      "Edit(/tools/guard/**)",
      "Write(tools/guard/**)",
      "Write(/tools/guard/**)",
      "Edit(.git/**)",
      "Edit(/.git/**)",
      "Write(.git/**)",
      "Write(/.git/**)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.local)",
      "Edit(**/.env.local)",
      "Read(**/.env.*.local)",
      "Edit(**/.env.*.local)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --force-if-includes:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push --mirror:*)",
      "Bash(git push --delete:*)",
      "Bash(git push * --delete *)",
      "Bash(git restore:*)",
      "Bash(git switch --discard-changes:*)",
      "Bash(git * --no-verify*)",
      "Bash(git config --global:*)",
      "Bash(git config --system:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/guard/claude_hook.py\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
