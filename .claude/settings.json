      "WebFetch(domain:kafka.apache.org)",
      "WebFetch(domain:redis.io)",
      "WebFetch(domain:www.archunit.org)",
      "WebFetch(domain:micrometer.io)",
      "WebFetch(domain:docs.micrometer.io)",
      "WebFetch(domain:opentelemetry.io)",
      "WebFetch(domain:www.mkdocs.org)",
      "WebFetch(domain:squidfunk.github.io)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.anthropic.com)",
