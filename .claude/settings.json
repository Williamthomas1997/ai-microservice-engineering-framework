{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Bash(mvn:*)",
      "Bash(./mvnw:*)",
      "Bash(mvnw:*)",
      "Bash(mvnw.cmd:*)",
      "Bash(java:*)",
      "Bash(javac:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(py:*)",
      "Bash(pip:*)",
      "Bash(pipx:*)",
      "Bash(pytest:*)",
      "Bash(gitleaks:*)",
      "Bash(curl:*)",
      "Bash(tar:*)",
      "Bash(ls:*)",
      "Bash(dir:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(touch:*)",
      "Bash(echo:*)",
      "Bash(sleep:*)",
      "Bash(where:*)",
      "Bash(which:*)",
      "Bash(powershell:*)",
      "Bash(pwsh:*)",
      "Bash(winget:*)",
      "Bash(mkdocs:*)",
      "Bash(rm:*)",
      "Bash(del:*)"
    ],
    "deny": [
      "Bash(git checkout:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git filter-repo:*)",
      "Bash(git filter-branch:*)",
      "Bash(rm -rf /:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/tools/guard/claude_hook.py\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
