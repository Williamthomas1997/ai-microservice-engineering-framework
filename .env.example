# Copy to .env (git-ignored) and fill in locally. Placeholders only: never commit real values.
# Services read these through ${ENV} placeholders in application.yaml.

# Redis (redis brick)
AMEF_REDIS_HOST=localhost
AMEF_REDIS_PORT=6379
AMEF_REDIS_PASSWORD=change-me

# Kafka (messaging brick)
AMEF_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Postgres (outbox, audit-service, gateway routes)
AMEF_DB_URL=jdbc:postgresql://localhost:5432/amef
AMEF_DB_USERNAME=amef
AMEF_DB_PASSWORD=change-me

# Observability (optional OTLP export; leave empty to disable)
AMEF_OTLP_ENDPOINT=

# Gateway authentication (M7)
AMEF_GATEWAY_AUTH_ISSUER=
AMEF_GATEWAY_AUTH_JWKS_URI=

# AI layer (M10; only for evals / PR review)
ANTHROPIC_API_KEY=
